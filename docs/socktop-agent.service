# Manual (non-package) install. The unit that cargo-deb installs is
# socktop_agent/socktop-agent.service; the only difference is the ExecStart path.
# Change the limits in both or neither.
[Unit]
Description=Socktop agent
Documentation=https://github.com/jasonwitty/socktop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/socktop_agent --port 3000
Environment=RUST_LOG=info
# Optional auth:
# Environment=SOCKTOP_TOKEN=changeme
Restart=on-failure
RestartSec=5
User=socktop
Group=socktop
NoNewPrivileges=true

# Security hardening
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/socktop
StateDirectory=socktop

# Resource limits, so the agent is something you install and forget.
#
# Measured on a Pi 5 with one client at the TUI's default cadence: about 0.4% of
# one core and 5.4 MB resident. The numbers below are not that; they are the
# ceiling a mistake would hit — a stuck poll, or a client flooding `get_processes`
# (see docs/SECURITY_REVIEW.md S3), can now cost a quarter of one core and no more.
# At the default cadence nothing near these is ever reached, so the limits are not
# felt in normal use.
#
# MemoryHigh is where the kernel starts reclaiming aggressively, MemoryMax where a
# cgroup kill happens: a leak becomes a restart, not a swapped Pi.
# IOSchedulingClass=idle is appropriate because the only disk I/O the agent does is
# `journalctl` for the process-detail view, which should yield to everything else on
# an SD card.
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryHigh=32M
MemoryMax=48M

[Install]
WantedBy=multi-user.target
